# ==== Salin file ini menjadi .env lalu sesuaikan ====

# Nama aplikasi (tampil di header UI)
APP_NAME=Generator Sertifikat

# Lokasi data persisten.
#  - Lokal (tanpa Docker): ./data
#  - Docker: diabaikan, docker-compose memaksa /data (volume ./data:/data)
DATA_DIR=./data

# Batas ukuran tiap upload (MB): background, font, dan file data peserta.
MAX_UPLOAD_MB=25

# Batas jumlah baris peserta per sekali generate.
MAX_ROWS=5000

# Jumlah thread render paralel di dalam worker (naikkan sesuai jumlah vCPU).
RENDER_WORKERS=4

# Berapa menit hasil ZIP & file data upload disimpan sebelum dibersihkan otomatis.
JOB_RETENTION_MIN=120

# Proteksi Basic Auth. SANGAT disarankan untuk VPS publik.
# Kosongkan keduanya untuk menonaktifkan proteksi.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Port HTTP yang diekspos nginx di VPS (dipakai docker-compose).
HTTP_PORT=80

# Font fallback tambahan, path absolut dipisah koma. Kosong = deteksi otomatis
# (di Docker sudah tersedia DejaVu Sans).
FALLBACK_FONTS=
